    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/r_upper_arm.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="3e-5" iyy="1e-5" izz="3e-5" ixy="0" ixz="0" iyz="0"/>
