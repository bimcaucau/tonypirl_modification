    </collision>
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="3.5e-5" iyy="3.5e-5" izz="1.2e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="r_knee" type="revolute">
    <parent link="r_thigh"/>
    <child link="r_shin"/>
    <origin xyz="0.0 0.0 -0.059" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.094" effort="2.5" velocity="4.0"/>
  </joint>

  <link name="r_ankle">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/r_ankle.stl" scale="1 1 1"/>
      </geometry>
      <material name="joint"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/r_ankle.stl" scale="1 1 1"/>
