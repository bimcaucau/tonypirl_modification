      <inertia ixx="2e-5" iyy="3e-5" izz="4e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="l_ankle_roll" type="revolute">
    <parent link="l_ankle"/>
    <child link="l_foot"/>
    <origin xyz="0.0 0.0 -0.0465" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.047" upper="1.047" effort="2.0" velocity="4.0"/>
  </joint>

  <!-- ============================ Right Leg ============================ -->
  <link name="r_hip">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/r_hip.stl" scale="1 1 1"/>
      </geometry>
      <material name="joint"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
