  <joint name="r_hip_pitch" type="revolute">
    <parent link="r_hip"/>
    <child link="r_thigh"/>
    <origin xyz="0.0 0.0 -0.0465" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094" upper="2.094" effort="2.5" velocity="4.0"/>
  </joint>

  <link name="r_shin">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/r_shin.stl" scale="1 1 1"/>
      </geometry>
      <material name="accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/r_shin.stl" scale="1 1 1"/>
