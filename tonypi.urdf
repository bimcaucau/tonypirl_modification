  </link>

  <joint name="r_upperarm_roll" type="revolute">
    <parent link="r_shoulder"/>
    <child link="r_upper_arm"/>
    <origin xyz="0.0 -0.0244 0.0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-2.094" upper="2.094" effort="1.5" velocity="4.0"/>
  </joint>

  <link name="r_forearm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/r_forearm.stl" scale="1 1 1"/>
      </geometry>
      <material name="accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/r_forearm.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.06"/>
      <inertia ixx="2e-5" iyy="8e-6" izz="2e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="r_elbow" type="revolute">
    <parent link="r_upper_arm"/>
    <child link="r_forearm"/>
    <origin xyz="0.0 0.0 -0.0489" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-2.094" upper="2.094" effort="1.2" velocity="4.0"/>
  </joint>

  <!-- ============================ Left Leg ============================ -->
  <link name="l_hip">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/l_hip.stl" scale="1 1 1"/>
