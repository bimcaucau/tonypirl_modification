      <material name="joint"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/l_hip.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="l_hip_roll" type="revolute">
    <parent link="pelvis"/>
    <child link="l_hip"/>
    <origin xyz="0.0 0.033 -0.044" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.047" upper="1.047" effort="2.0" velocity="4.0"/>
  </joint>

  <link name="l_thigh">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/l_thigh.stl" scale="1 1 1"/>
      </geometry>
      <material name="shell"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/l_thigh.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.12"/>
      <inertia ixx="4e-5" iyy="4e-5" izz="1.5e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="l_hip_pitch" type="revolute">
    <parent link="l_hip"/>
    <child link="l_thigh"/>
    <origin xyz="0.0 0.0 -0.0465" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094" upper="2.094" effort="2.5" velocity="4.0"/>
  </joint>

  <link name="l_shin">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/l_shin.stl" scale="1 1 1"/>
      </geometry>
      <material name="accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/l_shin.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="3.5e-5" iyy="3.5e-5" izz="1.2e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="l_knee" type="revolute">
    <parent link="l_thigh"/>
    <child link="l_shin"/>
    <origin xyz="0.0 0.0 -0.059" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.094" effort="2.5" velocity="4.0"/>
  </joint>

  <link name="l_ankle">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/l_ankle.stl" scale="1 1 1"/>
      </geometry>
      <material name="joint"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/l_ankle.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.04"/>
      <inertia ixx="8e-6" iyy="8e-6" izz="8e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="l_ankle_pitch" type="revolute">
    <parent link="l_shin"/>
    <child link="l_ankle"/>
    <origin xyz="0.0 0.0 -0.058" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.571" upper="1.571" effort="2.0" velocity="4.0"/>
  </joint>

  <link name="l_foot">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/l_foot.stl" scale="1 1 1"/>
