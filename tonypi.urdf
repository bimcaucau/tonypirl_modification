      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/r_foot.stl" scale="1 1 1"/>
      </geometry>
      <material name="shell"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/r_foot.stl" scale="1 1 1"/>
