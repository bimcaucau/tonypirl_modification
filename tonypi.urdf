    <axis xyz="1 0 0"/>
    <limit lower="-1.047" upper="1.047" effort="2.0" velocity="4.0"/>
  </joint>

  <link name="r_thigh">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/r_thigh.stl" scale="1 1 1"/>
      </geometry>
      <material name="shell"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tonypi_description/meshes/r_thigh.stl" scale="1 1 1"/>
      </geometry>
